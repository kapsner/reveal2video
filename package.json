{
  "name": "reveal2video",
  "version": "1.0.1",
  "description": "Convert Reveal.js slideshow with audio to HQ video (*.mkv).",
  "type": "module",
  "main": "reveal2video.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "bundle": "esbuild reveal2video.js --bundle --platform=node --target=node22 --format=cjs --external:typescript --outfile=dist/bundle.cjs",
    "build": "npm run bundle && pkg dist/bundle.cjs --no-bytecode --public --targets node22-linux-x64 --output reveal2video"
  },
  "dependencies": {
    "puppeteer": "^25.9.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.4.0",
    "esbuild": "^0.25.0",
    "yauzl": "^3.4.0"
  },
  "bin": {
    "reveal2video": "./reveal2video.js"
  },
  "allowScripts": {
    "puppeteer@25.9.0": true
  }
}
